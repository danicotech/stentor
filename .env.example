# 複製成 .env 後填值。.env 永遠不進版控。
#
# 這份清單裡沒有資料庫連線字串,而且永遠不該有。
# 真的填了也開不起來 —— src/config/env.ts 會直接拒絕啟動。

# ── Discord
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# 開發期把指令只註冊到測試伺服器,生效是即時的(全域指令要等 Discord 的快取)。
DISCORD_DEV_GUILD_ID=
# MESSAGE_CONTENT 是特權 intent,要跟 Discord 申請。
# 關掉仍然會記訊息「則數」(那不需要特權 intent),只是不會有內容。
DISCORD_MESSAGE_CONTENT_INTENT=true

# ── 平台(hestia)
PLATFORM_API_URL=http://localhost:8088/api
# 網頁前端的位址。/bind 與「你還沒綁定」的指引都指向它的 /login。
# 綁定只能在使用者自己的瀏覽器裡完成(OAuth 的 state 綁 cookie),Bot 只能給連結。
WEB_BASE_URL=http://localhost:5173
# service token。stentor 用它呼叫 hestia,並帶 X-Acting-User 代理使用者。
PLATFORM_SERVICE_TOKEN=

# ── 活動路由
# 格式:<前綴>=<base URL>[;public][;update],逗號分隔。
#   public  預設回覆是公開的(不加就是只有自己看得到)
#   update  元件互動預設就地更新原訊息
# 加一個活動 = 在這裡多一個項目。這個 repo 一行都不用改。
ACTIVITY_ROUTES=


# ── 其他
LOG_LEVEL=info
# 訊息批次:湊到幾則、或幾毫秒送一次(hestia 的 RecordMessages 是批次介面)
MESSAGE_BATCH_SIZE=25
MESSAGE_FLUSH_MS=5000
# 呼叫後端的逾時。Discord 的互動只有 3 秒,超過再等也沒意義。
BACKEND_TIMEOUT_MS=8000
